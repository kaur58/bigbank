{
  "name": "mugloar-player",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A resilient console player for Dragons of Mugloar",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "coverage": "c8 --all --include 'src/**/*.ts' --exclude 'src/models/**/*.ts' --reporter=text --reporter=html npm test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "c8": "^12.0.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2"
  }
}
